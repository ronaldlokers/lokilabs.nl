---
import { jobs, skills, education } from '../../data/history';
---
<div class="lk-doc">
  <h1>ronald lokers</h1>
  <div class="lk-cv-role">platform / devops engineer</div>
  <div class="lk-cv-actions">
    <a href="mailto:ronald@lokilabs.nl" data-track="mailto">get in touch</a>
    <a class="alt" href="https://www.linkedin.com/in/ronaldlokers/" data-track="linkedin">linkedin ↗</a>
    <button type="button" class="alt" data-print>print / save pdf</button>
  </div>
  <p class="lk-cv-print-contact">ronald@lokilabs.nl &middot; linkedin.com/in/ronaldlokers</p>
  <div class="lk-cv-summary">15+ years of engineering — frontend and fullstack at Coolblue, Mendix, and Oliver IT — with a career-long pull toward build tooling, CI/CD, and infrastructure. since mid-2025 fully committed to platform engineering. if i do something twice, it becomes a script.</div>
  <div class="lk-cv-skills">{skills.map((s) => <span>{s}</span>)}</div>
  <div class="lk-cv-jobs">
    {jobs.map((job) => (
      <div class="lk-cv-job">
        <div class="row">
          <span class="role">{job.role} {job.org && <span class="org">@ {job.org}</span>}{job.tag && <span class="tag">{job.tag}</span>}</span>
          <span class="dates">{job.when}</span>
        </div>
        {job.desc && <p>{job.desc}</p>}
      </div>
    ))}
  </div>
  <h2 class="lk-cv-subhead">education</h2>
  <div class="lk-cv-edu">
    {education.map((e) => (
      <div class="lk-cv-edu-row">
        <span class="what">{e.what} <span class="where">· {e.where}</span></span>
        <span class="dates">{e.when}</span>
      </div>
    ))}
  </div>
  {/* The CV is where the decision gets made — it used to end on a 2005 side
      gig and nothing else. Ask for the reply while the evidence is still on
      screen. */}
  <div class="lk-cv-close">
    <p class="lk-cv-close-line"><span class="p">$</span> echo "still reading? let's talk."</p>
    <div class="lk-cv-close-actions">
      <a class="lk-cv-close-mail" href="mailto:ronald@lokilabs.nl" data-track="mailto">get in touch →</a>
      <a class="lk-cv-close-alt" href="https://www.linkedin.com/in/ronaldlokers/" data-track="linkedin">linkedin ↗</a>
    </div>
  </div>
</div>
